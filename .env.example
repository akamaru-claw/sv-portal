# Adresse, unter der das Portal öffentlich erreichbar ist (für Einladungslinks, QR-Codes, Kalender-Abo)
PUBLIC_URL=https://sv.mauri-tools.de

# Anzeige
SITE_NAME=SV-Portal
SCHOOL_NAME=Mauritius-Gymnasium Büren

# Maximale Größe pro hochgeladener Datei in MB
MAX_UPLOAD_MB=25

# Wie lange man angemeldet bleibt (Tage, verlängert sich bei Nutzung)
SESSION_DAYS=30

# Anzahl Reverse-Proxys vor der App (Caddy/nginx = 1). Ohne Proxy: 0
TRUST_PROXY=1

# Kalender-Abo per persönlichem Link (true/false)
CALENDAR_FEED=true
